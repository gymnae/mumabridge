HTTP_ADDRESS=:8080
LOG_LEVEL=info
STATE_PATH=/var/lib/mumabridge

MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_SERVER_NAME=example.org
MATRIX_ROOM_ID=!replace:example.org
MATRIX_AS_TOKEN=replace-me
MATRIX_HS_TOKEN=replace-me
MATRIX_SENDER_LOCALPART=mumabridge
MATRIX_GHOST_PREFIX=mumabridge_mumble_

# Direct LiveKit mode: the bridge signs its own participant JWTs with these
# credentials, so no separate focus/JWT service URL is needed. LIVEKIT_ROOM
# is optional and defaults to MATRIX_ROOM_ID; set it only if Element Call maps
# the Matrix room to a different LiveKit room name.
LIVEKIT_URL=wss://livekit.example.org
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_ROOM=

MUMBLE_ADDRESS=mumble.example.org:64738
MUMBLE_CHANNEL=Root
MUMBLE_USERNAME=mumabridge
MUMBLE_PASSWORD=
MUMBLE_CERT_FILE=
MUMBLE_KEY_FILE=
MUMBLE_INSECURE_TLS=false
MUMBLE_GHOST_PREFIX=[mx] 

MEDIA_SAMPLE_RATE=48000
MEDIA_CHANNELS=1
MEDIA_FRAME_MS=20
MEDIA_QUEUE_FRAMES=25
MAX_PARTICIPANTS=32
